-- Client entry point: title screen, HUD, audio, effects, flashlight, grabbing and screen shake.
-- The camera is the normal Roblox third-person camera.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AdminPanel = require(script.AdminPanel)
local Audio = require(script.Audio)
local CameraGuard = require(script.CameraGuard)
local CameraShake = require(script.CameraShake)
local CharacterAudio = require(script.CharacterAudio)
local CodesPanel = require(script.CodesPanel)
local DailyPanel = require(script.DailyPanel)
local Danger = require(script.Danger)
local Doors = require(script.Doors)
local Effects = require(script.Effects)
local Flashlight = require(script.Flashlight)
local GearPanel = require(script.GearPanel)
local Grab = require(script.Grab)
local Hud = require(script.Hud)
local LookButton = require(script.LookButton)
local Menu = require(script.Menu)
local Parkour = require(script.Parkour)
local Roles = require(script.Roles)
local Sense = require(script.Sense)
local Spectate = require(script.Spectate)
local TitleScreen = require(script.TitleScreen)

CameraShake.start()
CameraGuard.start()
Audio.start()
Hud.start()
Effects.start()
CharacterAudio.start()
Danger.start()
Doors.start()
Flashlight.start()
Grab.start()
GearPanel.start()
Menu.start() -- before the panels that put buttons in it
CodesPanel.start()
DailyPanel.start()
LookButton.start()
Spectate.start()
Sense.start()
Roles.start()
Parkour.start()
AdminPanel.start()

TitleScreen.show(function()
	Audio.beginGame()
end)

local remotes = ReplicatedStorage:WaitForChild("Remotes")
remotes:WaitForChild("Effect").OnClientEvent:Connect(function(kind: string, data)
	Effects.handle(kind, data)
	Hud.handle(kind, data)
	GearPanel.handle(kind, data)
	Roles.handle(kind, data)
	Parkour.handle(kind, data)
	DailyPanel.handle(kind, data)
end)
